<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.innospots</groupId>
        <artifactId>nexmux</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>nexmux-kernel</artifactId>
    <name>nexmux-kernel</name>
    <description>Unified product kernel: core, console, and inbound.</description>

    <dependencies>
        <dependency>
            <groupId>com.innospots</groupId>
            <artifactId>innospots-nexus-platform</artifactId>
        </dependency>
        <!-- 测试 classpath 需要 JAX-RS RuntimeDelegate 实现（jakarta.ws.rs.core.Response） -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-common</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>smallrye-open-api-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-openapi</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate-schema</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/nexus-openapi</outputDirectory>
                            <schemaFilename>${project.artifactId}</schemaFilename>
                            <outputFileTypeFilter>YAML</outputFileTypeFilter>
                            <encoding>UTF-8</encoding>
                            <scanners>
                                <scanner>JAX-RS</scanner>
                            </scanners>
                            <scanPackages>
                                com.innospots.nexmux.console,
                                com.innospots.nexmux.core,
                                com.innospots.nexus.base.domain.response,
                                com.innospots.nexus.base.i18n,
                                com.innospots.nexus.base.domain.enums
                            </scanPackages>
                            <scanDependenciesDisable>false</scanDependenciesDisable>
                            <openApiVersion>3.1.0</openApiVersion>
                            <operationIdStrategy>CLASS_METHOD</operationIdStrategy>
                            <infoTitle>Nexmux Console API</infoTitle>
                            <infoVersion>1.0.0</infoVersion>
                            <infoDescription>Nexmux 模型网关管理控制台 Jakarta REST 契约；运行时仅暴露构建期生成的 OpenAPI。</infoDescription>
                            <infoContactName>Innospots Nexmux</infoContactName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
