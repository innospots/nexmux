<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.innospots</groupId>
        <artifactId>nexmux</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>nexmux-spring</artifactId>
    <packaging>jar</packaging>

    <name>nexmux-spring</name>
    <description>Spring Boot runnable assembly for nexmux-kernel.</description>

    <dependencies>
        <dependency>
            <groupId>com.innospots</groupId>
            <artifactId>nexmux-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.innospots</groupId>
            <artifactId>innospots-nexus-spring-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 与 sample 一致：资源进 classpath，供 IDE / spring-boot:run；发行包 config/ 仍由 assembly 从源码目录拷贝 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
