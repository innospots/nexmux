{
  "name": "nexmux-ui-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9011",
    "build": "node scripts/build.mjs production",
    "start": "next start -p 9011",
    "lint": "eslint src module",
    "typecheck": "tsc --noEmit",
    "build:dev": "node scripts/build.mjs development",
    "build:test": "node scripts/build.mjs test",
    "build:module": "pactor module build",
    "pack:module": "pactor module pack --no-bump"
  },
  "dependencies": {
    "@pactor-app/core": "1.72.0",
    "@pactor-app/runtime": "1.72.0",
    "@pactor-app/ui": "1.72.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "pactor-app": "1.72.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@pactor-app/cli": "1.72.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "files": [
    "dist-module"
  ],
  "exports": {
    "./manifest": "./dist-module/manifest.json",
